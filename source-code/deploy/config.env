#############################################################################
#  TIMESHEET EXTRACTION & VALIDATION  --  CONFIGURATION FILE
#############################################################################
#
#  This is the ONLY file you need to edit.
#
#  Every line below is "SETTING=value". To change something, edit the value
#  after the "=" sign, save the file, then restart the application by running:
#
#        ./restart.sh          (Linux / Mac)
#        restart.bat           (Windows)
#
#  Changes do nothing until you restart.
#
#  Lines starting with "#" are notes for you and are ignored by the computer.
#
#  The defaults below are the values that were tested and measured. If you are
#  not sure about a setting, leave it alone.
#
#############################################################################


#============================================================================
#  1. NETWORK  --  where people open the application in their browser
#============================================================================

# The port number the application listens on.
#
# With the default of 8077, staff open:   http://<your-server-address>:8077
#
# Change this ONLY if port 8077 is already used by something else on the
# server. Common alternative: 8080. If you set it to 80, staff can leave the
# port off the address entirely (just http://<your-server-address>).
TS_PORT=8077


#============================================================================
#  2. EMPLOYEE ROSTER  --  the master list of staff
#============================================================================
#
#  The roster is the list of employees the system matches handwritten names
#  against. It lives in the "data" folder next to this file, as roster.csv.
#
#  A roster is INCLUDED with this package (1,863 employees).
#
#  To update it later you do NOT need to edit any file here -- an administrator
#  can upload a new roster directly in the web page. It takes effect at once.

# How certain the system must be before it accepts a handwritten name as a
# match for someone on the roster. Scale is 0-100.
#
#   Higher (e.g. 90) = fewer wrong matches, but more sheets sent for review.
#   Lower  (e.g. 70) = fewer sheets sent for review, but risks paying the
#                      WRONG employee.
#
# 82 is the tested value. Raise it rather than lower it if you are unsure --
# a confident match to the wrong person is the expensive kind of mistake.
TS_ROSTER_MIN_SCORE=82

# How far ahead the best-matching name must be from the second-best before the
# system trusts it. This stops it from guessing between two similar names
# (for example "Nitin Deshmukh" and "Yogesh Raman") -- if they score too close
# together, the sheet is flagged for a human instead.
TS_ROSTER_MIN_MARGIN=6


#============================================================================
#  3. VALIDATION RULES  --  when a timesheet gets flagged for human review
#============================================================================

# Maximum overtime hours allowed on a single day. More than this is flagged.
TS_OT_MAX_DAY=12

# Maximum normal (non-overtime) hours allowed on a single day.
TS_NORMAL_MAX_DAY=12

# How much the individual day-by-day hours are allowed to disagree with the
# monthly total written at the bottom of the sheet, as a fraction.
#
#   0.02 means "allow up to 2% difference".
#
# This is not sloppiness: reading ~30 handwritten cells accumulates small
# errors, so demanding an exact match would flag almost every sheet. Set it to
# 0 only if you want every single rounding difference escalated to a person.
TS_SUM_TOLERANCE_PCT=0.02

# Tolerance used when comparing individual hour values. Leave as is.
TS_HOURS_TOLERANCE=0.01


#============================================================================
#  4. IMAGE PROCESSING  --  reading quality vs speed
#============================================================================

# The size each page is scaled to before reading, in pixels on its long edge.
#
#   Larger (e.g. 2000) reads messy handwriting slightly better but is
#   noticeably slower, and increases memory use.
#   Smaller (e.g. 1200) is faster but starts missing faint pencil.
#
# 1600 is the tested compromise. Do not change this without re-measuring
# accuracy -- it directly affects how well the system reads.
TS_PAGE_LONG_EDGE=1600

# Maximum rotation, in degrees, that the system will straighten automatically
# on a crooked scan or photo. Sheets more crooked than this are left alone.
TS_MAX_DESKEW_DEG=15


#============================================================================
#  5. OPTIONAL AI FALLBACK  --  off by default, and deliberately so
#============================================================================
#
#  The system can optionally call a local AI vision model (via Ollama) to
#  re-read page headers it could not interpret.
#
#  It is set to 0 (OFF) here because it was measured as unnecessary: with it
#  switched off the system still scored 89.5% overall / 89.6% on day-by-day
#  attendance. Turning it on requires installing Ollama separately, adds about
#  3 GB, needs considerably more memory, and makes each unclear page ~24
#  seconds slower.
#
#  Leave this OFF unless someone technical has installed Ollama and measured
#  an improvement on YOUR documents.

# 0 = off (recommended), 1 = on
TS_VLM_HEADER=0

# These only matter if you set TS_VLM_HEADER=1 above.
# Note: "127.0.0.1" means "this same machine". Inside a container that is the
# container itself, so pointing at an Ollama running on the SERVER requires
# host.docker.internal instead. Ask a technical person before enabling.
TS_OLLAMA_URL=http://host.docker.internal:11434
TS_VLM_MODEL=qwen3-vl:4b
TS_VLM_TIMEOUT_S=600

# Reads each page twice and treats disagreement between the two readings as a
# sign of uncertainty. Only has an effect when the AI fallback above is ON.
TS_DUAL_PASS=1

# Reads the summary box separately from the day grid, so the totals cannot be
# quietly derived from the rows -- which would make the cross-check meaningless.
# Only has an effect when the AI fallback above is ON. Leave at 1.
TS_INDEPENDENT_SUMMARY=1


#============================================================================
#  6. ADVANCED  --  you should not normally touch anything below
#============================================================================

# Where the application stores its data INSIDE the container. This is wired to
# the "data" folder next to this file by docker-compose.yml. Changing it will
# break that link and the application will lose sight of your roster and
# database.
TS_DATA_DIR=/data
